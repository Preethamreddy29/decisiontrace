  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
        "IngestionJob": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "job_id",
            "source_version_id",
            "status"
          ],
          "properties": {
            "job_id": {
              "type": "string",
              "format": "uuid"
            },
            "source_version_id": {
              "type": "string",
              "format": "uuid"
            },
            "status": {
              "type": "string",
              "enum": [
                "received",
                "validated",
                "stored",
                "parsed",
                "chunked",
                "embedded",
                "linked",
                "review_required",
                "ready",
                "failed",
                "quarantined",
                "deleted"
              ]
            },
            "failure_code": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "DriftScanRequest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision_version_ids"
          ],
          "properties": {
            "decision_version_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        },
        "DriftScan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scan_id",
            "status"
          ],
          "properties": {
            "scan_id": {
              "type": "string",
              "format": "uuid"
            },
            "status": {
              "type": "string",
              "enum": [
                "queued",
                "running",
                "completed",
                "failed"
              ]
            }
          }
        },
        "DriftFinding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "finding_id",
            "decision_version_id",
            "evidence_version_id",
            "kind",
            "status"
          ],
          "properties": {
            "finding_id": {
              "type": "string",
              "format": "uuid"
            },
            "decision_version_id": {
              "type": "string",
              "format": "uuid"
            },
            "evidence_version_id": {
              "type": "string",
              "format": "uuid"
            },
            "kind": {
              "type": "string",
              "enum": [
                "stale_test",
                "unimplemented_decision",
                "expired_assumption",
                "contradiction"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "open",
                "dismissed",
                "resolved"
              ]
            }
          }
        },
        "EvaluationRequest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "corpus_manifest_sha256",
            "pipeline_version"
          ],
          "properties": {
            "corpus_manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "pipeline_version": {
              "type": "string"
            }
          }
        },
        "EvaluationRun": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evaluation_id",
            "status",
            "corpus_manifest_sha256"
          ],
          "properties": {
            "evaluation_id": {
              "type": "string",
              "format": "uuid"
            },
            "status": {
              "type": "string",
              "enum": [
                "queued",
                "running",
                "completed",
                "failed"
              ]
            },
            "corpus_manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "title",
          "status",
          "code",
          "request_id"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "SourceCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "origin",
          "content",
          "valid_from",
          "permissions"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "markdown",
              "transcript",
              "json"
            ]
          },
          "origin": {
            "type": "string",
            "maxLength": 500
          },
          "content": {
            "type": "string",
            "maxLength": 1000000
          },
          "valid_from": {
            "type": "string",
            "format": "date"
          },
          "valid_to": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "permissions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "owner",
                "engineer",
                "qa",
                "auditor",
                "viewer"
              ]
            }
          }
        }
      },
      "SourceVersion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "version_id",
          "version",
          "kind",
          "sha256",
          "recorded_at",
          "status"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "format": "uuid"
          },
          "version_id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "received",
              "review_required",
              "ready",
              "revoked",
              "failed"
            ]
          },
          "valid_from": {
            "type": "string",
            "format": "date"
          },
          "valid_to": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "content": {
            "type": "string",
            "description": "Returned only to an authorized reader."
          }
        }
      },
      "DecisionDraft": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "valid_from",
          "evidence_version_ids",
          "owner_id"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 300
          },
          "valid_from": {
            "type": "string",
            "format": "date"
          },
          "valid_to": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "evidence_version_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "owner_id": {
            "type": "string",
            "format": "uuid"
          },
          "supersedes_decision_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "DecisionVersion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision_id",
          "version_id",
          "version",
          "status",
          "valid_from",
          "recorded_at",
          "evidence_version_ids"
        ],
        "properties": {
          "decision_id": {
            "type": "string",
            "format": "uuid"
          },
          "version_id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "in_review",
              "approved",
              "rejected",
              "superseded"
            ]
          },
          "valid_from": {
            "type": "string",
            "format": "date"
          },
          "valid_to": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "owner_id": {
            "type": "string",
            "format": "uuid"
          },
          "approver_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "evidence_version_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "etag": {
            "type": "string"
          }
        }
      },
      "ReviewAction": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "approve",
              "reject"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 2000
          }
        }
      },
      "QueryRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "recorded_as_of"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 3,
            "maxLength": 2000
          },
          "valid_on": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "recorded_as_of": {
            "type": "string",
            "format": "date-time"
          },
          "source_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "answer_mode": {
            "type": "string",
            "enum": [
              "structured",
              "generated"
            ],
            "default": "structured"
          }
        }
      },
      "Citation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "version_id",
          "section_id",
          "label"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "format": "uuid"
          },
          "version_id": {
            "type": "string",
            "format": "uuid"
          },
          "section_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "Claim": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "citations"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "citations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/Citation"
            }
          }
        }
      },
      "Answer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "answer_id",
          "status",
          "claims",
          "corpus_or_index_version",
          "recorded_as_of"
        ],
        "properties": {
          "answer_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "answered",
              "conflict",
              "abstain",
              "denied"
            ]
          },
          "claims": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Claim"
            }
          },
          "conflict_summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "abstention_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "corpus_or_index_version": {
            "type": "string"
          },
          "recorded_as_of": {
            "type": "string",
            "format": "date-time"
          },
          "valid_on": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "pipeline_versions": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
