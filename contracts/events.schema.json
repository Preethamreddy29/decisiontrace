{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/decisiontrace/local-outbox/v1.schema.json",
  "title": "DecisionTrace local outbox event v1",
  "description": "The current local worker validates and acknowledges these events. This is an internal outbox contract, not a published RuleTwin integration event or proof of external delivery. event_id and occurred_at map to outbox_events.id and created_at.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_version",
    "tenant_id",
    "event_type",
    "occurred_at",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_version": {
      "const": 1
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "foundation.ping",
        "source.created",
        "source.versioned",
        "source.connector_created",
        "source.connector_versioned",
        "source.revoked",
        "decision.drafted",
        "decision.reviewed",
        "change_watch.created",
        "change_watch.reviewed"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "foundation.ping"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "maxProperties": 0
          }
        }
      },
      "else": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "subject_id"
            ],
            "properties": {
              "subject_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      }
    }
  ]
}
